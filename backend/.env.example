# Copia questo file in .env e compila i valori.
# --- Database ---------------------------------------------------------
MONGO_URL=
DB_NAME=waysout

# --- Provider: Amadeus (nota: la sandbox è gratuita, la produzione no) --
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# --- Provider: Sky-scrapper (via RapidAPI) -----------------------------
RAPIDAPI_SKYSCRAPPER_KEY=
RAPIDAPI_SKYSCRAPPER_HOST=sky-scrapper.p.rapidapi.com

# --- Provider: Travelpayouts (Aviasales Data API) - dati "cached", non --
# --- una ricerca live: vedi backend/src/providers/travelpayouts.js -----
TRAVELPAYOUTS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Provider: Kiwi.com (Tequila API) - ricerca live -------------------
# Inerte finché questa chiave non è impostata (vedi providers/kiwi.js)
KIWI_API_KEY=

# --- Provider: Ryanair (fare finder semi-pubblico) ----------------------
# Nessuna chiave richiesta - attivo di default. Imposta a "false" per
# disattivarlo se dovesse smettere di funzionare (vedi providers/ryanair.js)
RYANAIR_ENABLED=true

# --- Provider: SerpApi (Google Flights) - risultati live, A PAGAMENTO ---
# ATTENZIONE: piano gratuito limitato (verifica il numero esatto sul tuo
# account), poi si paga a ricerca. Una singola ricerca utente può generare
# fino a MAX_VERIFIED_DESTINATIONS chiamate a questo provider. Inerte
# finché questa chiave non è impostata.
SERPAPI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- CORS ---------------------------------------------------------------
# "*" per sviluppo locale (deve arrivare al middleware cors come stringa
# "true", non come array - vedi note nel README principale)
CORS_ORIGINS=*

# --- Server ---------------------------------------------------------------
PORT=3001
